{
  "name": "medai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "node scripts/backup-db.mjs",
    "pack": "node scripts/pack.mjs",
    "pack:submission": "node scripts/pack-submission.mjs",
    "test:api": "tsx scripts/api-test.ts",
    "ai:check": "node --env-file=.env scripts/check-ai.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "pdf-parse": "^1.1.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tesseract.js": "^5.1.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.170.0",
    "eslint": "9.37.0",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.6",
    "prisma": "6.16.2",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
