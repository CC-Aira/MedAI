# database
DATABASE_URL="file:./dev.db"

# 会话签名密钥：生产环境必须换成随机长串（openssl rand -hex 32）
SESSION_SECRET="dev-only-please-change-me-0123456789abcdef"

# DeepSeek
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# 没配 Key 时，把它设为 1 可以用本地模拟流跑通全链路（演示/自测用，生产请留空）
MEDAI_DEMO_AI=""

# 登录页要不要显示「用演示账号进去」那个按钮（1=显示，留空=不显示）
# 只在演示 / 评审环境打开；它仍走正常登录接口，不是后门
MEDAI_DEMO_LOGIN=""

# 聊天记录保留天数：超过这个天数的对话会自动清除，不永久保留
# 只清原始对话；「小结」「结论卡片」「患者档案」不受影响
MEDAI_CHAT_RETENTION_DAYS="30"
