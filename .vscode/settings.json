{
  // 这个项目有两万多个文件（绝大部分在 node_modules / .next），
  // 不排掉的话资源管理器、全文搜索、文件监听都会被拖慢
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.git/objects/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/package-lock.json": true,
    "**/*.log": true,
    "**/tsconfig.tsbuildinfo": true
  },
  "files.exclude": {
    "**/.next": true,
    "**/tsconfig.tsbuildinfo": true
  },

  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",

  "editor.tabSize": 2,
  "editor.rulers": [80, 100],
  "editor.formatOnSave": false,
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "emmet.includeLanguages": { "typescriptreact": "html" },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, .env*, tsconfig.json, next.config.ts, eslint.config.mjs, postcss.config.mjs",
    "*.ts": "${capture}.test.ts, ${capture}.spec.ts",
    "*.tsx": "${capture}.module.css"
  }
}
