// MedAI · PostgreSQL 版 schema（答辩演示不需要，见 docs/deploy.md §5）
//
// 和 schema.prisma 只有两处不同：
//   1. provider 从 sqlite 换成 postgresql；
//   2. 长文本字段补了 @db.Text —— SQLite 的 TEXT 没有长度上限，
//      Postgres 默认 varchar(191)，不补会被截断（报错更难查）。
//
// 用法：
//   DATABASE_URL="postgresql://..." npx prisma db push --schema=prisma/schema.postgres.prisma
//   npx prisma generate --schema=prisma/schema.postgres.prisma
// MedAI · 多患者 AI 辅助问诊系统
// 6 张表：User + Patient / Medication / Consultation / Message / Note
// SQLite 没有原生 enum，状态类字段一律用 String + 应用层白名单校验。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String // scrypt$salt$hash，永不存明文
  /// 角色：user = 个人用户，admin = 管理员
  role         String       @default("user")
  /// 最近一次登录成功的时间；从没登录过就是 null
  lastLoginAt  DateTime?
  /// 账号是否被停用：停用后无法登录，但数据保留
  disabled     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  patients     Patient[]
  attachments  Attachment[]
  feedbacks    Feedback[]
  labReports   LabReport[]

  @@index([role, createdAt])
}

model Patient {
  id             String   @id @default(cuid())
  ownerId        String // 归属账号，核心隔离字段
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  gender         String // male | female
  avatarUrl      String? // /uploads/avatars/xxx.png
  birthDate      DateTime?
  age            Int?
  heightCm       Float?
  weightKg       Float?
  bloodType      String?
  constitution   String? // 中医体质
  habits         String?  @db.Text // 生活习惯
  allergies      String?  @db.Text // 过敏史（对话时强制注入）
  chronicDisease String?  @db.Text // 既往病史
  chiefComplaint String? // 主诉
  medications    Medication[]
  consultations  Consultation[]
  notes          Note[]
  labReports     LabReport[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId, createdAt])
}

model Medication {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  drugName  String
  dosage    String? // "5mg"
  frequency String? // "每日一次"
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true) // 在服 / 已停用
  note      String?

  /// 每天几点吃，24 小时制 "08:00"；提醒文案要用
  timeOfDay  String?
  /// before | after | any（饭前 / 饭后 / 不限）
  mealTiming String?
  /// 疗程总天数；留空就用 startDate~endDate 推算
  courseDays Int?

  logs      MedicationLog[]
  createdAt DateTime        @default(now())

  @@index([patientId, isActive])
}

/// 用药打卡：一天记一行。没打卡的过去日期在结算时算漏服。
model MedicationLog {
  id           String     @id @default(cuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  /// 这一行对应哪一天（取当地 00:00），一天只允许一条
  scheduledFor DateTime
  /// 实际打卡时间；null 表示只登记了"跳过"
  takenAt      DateTime?
  /// taken | skipped
  status       String
  createdAt    DateTime   @default(now())

  @@unique([medicationId, scheduledFor])
  @@index([medicationId, scheduledFor])
}

model Consultation {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  status    String  @default("active") // active | archived
  summary   String?  @db.Text // AI 小结，作为后续会话的长期记忆
  /// 触发过红旗拦截时记下的 JSON（类别、时间、次数）；就诊摘要要引用它
  redFlag   String?
  /// 就诊摘要 JSON：单独存一份，方便「打完就带走」和重复打印，不必每次重算
  visitSheet String?
  messages  Message[]
  notes     Note[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String   @db.Text
  /// 这条回答的来源标记：null = 模型回答；"redflag" = 本地红旗拦截生成的
  flag           String?
  /// 用户改过这句话的时间；null = 没改过
  editedAt       DateTime?
  /// 附带的文件/图片，null = 纯文字
  attachmentId   String?
  attachment     Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([consultationId, createdAt])
}

/**
 * 用户上传给 AI 看的资料：病历照片、化验单、药盒、PDF 报告。
 * text 是服务端提取出来的文字，提示词只用它，绝不把二进制塞给模型。
 * 对话按保留窗口自动清理时，消息删掉但附件保留原文件引用，供用户自己查看。
 */
model Attachment {
  id        String    @id @default(cuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  sizeBytes Int
  kind      String // image | pdf | docx | text
  /// 提取出的正文；图片没识别出字就是空串
  text      String    @default("") @db.Text
  /// 磁盘上的文件名（服务器生成），读取走 /api/attachments/[id]/raw
  storedName String?
  createdAt DateTime  @default(now())
  messages  Message[]

  @@index([ownerId, createdAt])
}

model Note {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  title          String
  content        String   @db.Text
  tags           String? // 逗号分隔
  isFavorite     Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([patientId, isFavorite, createdAt])
}

/// 后台公告：登录后展示给用户的通知。置顶的排前面。
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  /// 是否置顶
  pinned    Boolean  @default(false)
  /// 是否启用；停用后前台不再展示
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, pinned, createdAt])
}

/// 后台操作日志：谁在什么时候动了什么，用于审计与追溯
model AdminLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  /// 动作标识，如 user.disable / announcement.create / settings.update
  action     String
  /// 操作对象的一句话描述
  target     String
  /// 补充详情（已做过脱敏，不放密码、不放对话原文）
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

/// 系统配置：键值对。后台「系统参数 / AI 模型配置」都写这里。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/**
 * 用户反馈：在「我的」页面提交的问题、建议、内容纠错。
 * 内容由用户主动写给管理员看，后台可直接读原文。
 */
model Feedback {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String    @default("suggest")
  content   String
  contact   String?
  rating    Int?
  page      String?
  status    String    @default("open")
  reply     String?
  handledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// 一份化验单（血常规 / 生化 / 尿常规……），由视觉模型从照片里抽成结构化指标。
/// 指标整体存 JSON 字符串而不是拆表：单子上的项目名与参考区间千差万别。
model LabReport {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  attachmentId String?
  /// 采样日期：模型从单子上读，读不到用上传时间
  takenAt      DateTime
  hospital     String   @default("")
  /// 单据类型：血常规 / 肝功能 / 肾功能 / 血脂 / 尿常规 / 其他
  kind         String   @default("")
  /// [{ name, value, unit, refText, abnormal }]，abnormal: high | low | ""
  items        String   @default("[]") @db.Text
  summary      String   @default("") @db.Text
  abnormalCount Int     @default(0)
  createdAt    DateTime @default(now())

  @@index([ownerId, patientId, takenAt])
}
